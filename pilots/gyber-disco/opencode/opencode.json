{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": ["eunice"],
  "model": "eunice/Qwen3.8-27B-UD-Q6_K_XL",
  "provider": {
    "eunice": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Eunice cluster inference",
      "options": {
        "baseURL": "http://llama-auth-proxy.workers.svc.cluster.local:8080/v1",
        "apiKey": "cluster-auth-proxy"
      },
      "models": {
        "Qwen3.8-27B-UD-Q6_K_XL": {
          "name": "Qwen3.8-27B-UD-Q6_K_XL",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "external_directory": "deny"
  }
}
